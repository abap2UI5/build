// src/standard only - src/ of abap2UI5's branch 702, the downported sources.
// The rules and the dependency of abap2UI5's abap_702.jsonc.
{
  "global": {
    "files": "/src/standard/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps/open-abap-core",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": true,
    "implement_methods": true,
    "line_length": {
      "length": 255
    },
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_bom": true,
    "xml_consistency": true
  }
}
