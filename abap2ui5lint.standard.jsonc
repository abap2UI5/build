// src/standard only - the abap2UI5-linter over the app classes the framework ships,
// with the settings of abap2UI5's abap2ui5lint.jsonc.
{
  "$schema": "./node_modules/@abap2ui5/linter/data/abap2ui5lint.schema.json",
  "paths": [
    "src/standard"
  ],
  "ignore": [
    "/src/standard/01/05/z2ui5_cl_ui5_llm_guide\\.",
    "/src/standard/03/02/",
    "/src/standard/02/z2ui5_cl_ui5_view_builder\\."
  ],
  "ui5": "1.71",
  "distribution": "openui5",
  "rules": {
    "chain-house-layout": {
      "severity": "warning"
    },
    "non-released-api": false
  },
  "render": false,
  "failOn": "warning"
}
