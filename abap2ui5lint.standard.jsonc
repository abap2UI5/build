// src/standard only - the abap2UI5-linter over the app classes of abap2UI5 and
// the addons. Every finding is reported; errors fail the run. The sources are
// held to their house style and their warnings in their own repositories
// (each with its baseline) - here they arrive as they are, downported, and a
// warning nobody can act on in this repository must not stop a delivery.
// sapui5: the addons use controls of SAPUI5-only libraries.
{
  "$schema": "./node_modules/@abap2ui5/linter/data/abap2ui5lint.schema.json",
  "paths": [
    "src/standard"
  ],
  "ignore": [
    "/src/standard/01/01/05/z2ui5_cl_ui5_llm_guide\\.",
    "/src/standard/01/03/02/",
    "/src/standard/01/02/z2ui5_cl_ui5_view_builder\\."
  ],
  "ui5": "1.71",
  "distribution": "sapui5",
  "rules": {
    "non-released-api": false
  },
  "render": false,
  "failOn": "error"
}
